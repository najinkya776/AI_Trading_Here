# ─── ANTHROPIC API ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here    # from console.anthropic.com

# ─── UPSTOX API ───────────────────────────────────────────────────────────────
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:8000/upstox/callback
UPSTOX_ACCESS_TOKEN=                          # filled at runtime after login

# ─── TELEGRAM ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here        # get from @BotFather
TELEGRAM_CHAT_ID=your_chat_id_here           # your personal chat ID

# ─── WEBHOOK SECURITY ─────────────────────────────────────────────────────────
WEBHOOK_SECRET=change_this_to_a_random_string  # TradingView sends this in header

# ─── TRADING MODE ─────────────────────────────────────────────────────────────
LIVE_TRADING=false                             # set true ONLY after paper testing
PAPER_CAPITAL=1000000                          # virtual capital in INR (10 Lakhs)

# ─── RISK PARAMETERS ──────────────────────────────────────────────────────────
MAX_POSITIONS=2                                # max open trades at once
RISK_PER_TRADE_PCT=0.5                         # % of capital risked per trade
DAILY_LOSS_LIMIT_PCT=2.0                       # stop trading if daily loss exceeds this
