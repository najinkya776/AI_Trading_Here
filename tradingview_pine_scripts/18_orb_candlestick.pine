//@version=5
strategy("18 - ORB + Candlestick Confirmation", overlay=true, default_qty_type=strategy.fixed, default_qty_value=75, commission_type=strategy.commission.cash_per_order, commission_value=100)

// ---- Inputs
tp_points  = input.float(40.0, "Take Profit (points)")
sl_points  = input.float(20.0, "Stop Loss (points)")
adx_min    = input.int(16, "Min ADX")
max_trades = input.int(3, "Max trades per day")

// ---- Indicators
ema_50   = ta.ema(close, 50)
ema_200  = ta.ema(close, 200)
atr_val  = ta.atr(14)
rsi_val  = ta.rsi(close, 14)
vwap_val = ta.vwap(hlc3)
[diplus, diminus, adx_val] = ta.dmi(14, 14)

// ---- Time windows
in_opening = not na(time("5", "0915-0930", "Asia/Kolkata"))
in_session = not na(time("5", "0930-1400", "Asia/Kolkata"))

// ---- Daily reset
var float orb_high     = na
var float orb_low      = na
var bool  orb_done     = false
var int   trades_today = 0

if dayofweek != dayofweek[1]
    orb_high     := na
    orb_low      := na
    orb_done     := false
    trades_today := 0

// ---- Build opening range
if in_opening
    orb_high := na(orb_high) ? high : math.max(orb_high, high)
    orb_low  := na(orb_low)  ? low  : math.min(orb_low, low)
if not in_opening and not na(orb_high)
    orb_done := true

// ---- Candle measurements
cbody  = math.abs(close - open)
crange = high - low
uwick  = high - math.max(close, open)
lwick  = math.min(close, open) - low

// ---- Candlestick Patterns (single line each — avoids line continuation issues)
bull_engulfing = close > open and close[1] < open[1] and close > open[1] and open < close[1] and cbody > cbody[1]
hammer         = close > open and crange > 0 and lwick >= cbody * 2.0 and uwick <= cbody * 0.4 and crange > atr_val * 0.4
bull_marubozu  = close > open and crange > 0 and cbody >= crange * 0.80 and crange > atr_val * 0.5

bear_engulfing = close < open and close[1] > open[1] and close < open[1] and open > close[1] and cbody > cbody[1]
shooting_star  = close < open and crange > 0 and uwick >= cbody * 2.0 and lwick <= cbody * 0.4 and crange > atr_val * 0.4
bear_marubozu  = close < open and crange > 0 and cbody >= crange * 0.80 and crange > atr_val * 0.5

bull_candle = bull_engulfing or hammer or bull_marubozu
bear_candle = bear_engulfing or shooting_star or bear_marubozu

// ---- Trend and filters
bull_trend = close > ema_50 and close > ema_200
bear_trend = close < ema_50 and close < ema_200
no_trade   = strategy.position_size != 0 or trades_today >= max_trades

// ---- Primary ORB signals
long_ok  = orb_done and ta.crossover(close, orb_high) and bull_candle and bull_trend and close > vwap_val and rsi_val > 48 and rsi_val < 72 and adx_val > adx_min and in_session and not no_trade
short_ok = orb_done and ta.crossunder(close, orb_low) and bear_candle and bear_trend and close < vwap_val and rsi_val < 52 and rsi_val > 28 and adx_val > adx_min and in_session and not no_trade

// ---- ORB retest signals
orb_retest_long  = orb_done and close > orb_high and low <= orb_high * 1.001 and bull_candle and bull_trend and rsi_val > 45 and rsi_val < 65 and adx_val > adx_min and in_session and trades_today >= 1 and not no_trade
orb_retest_short = orb_done and close < orb_low  and high >= orb_low * 0.999  and bear_candle and bear_trend and rsi_val < 55 and rsi_val > 35 and adx_val > adx_min and in_session and trades_today >= 1 and not no_trade

// ---- Execute
if long_ok or orb_retest_long
    strategy.entry("LONG", strategy.long)
    trades_today := trades_today + 1

if short_ok or orb_retest_short
    strategy.entry("SHORT", strategy.short)
    trades_today := trades_today + 1

// ---- Fixed TP / SL
if strategy.position_size > 0
    strategy.exit("LONG Exit", "LONG", limit=strategy.position_avg_price + tp_points, stop=strategy.position_avg_price - sl_points)

if strategy.position_size < 0
    strategy.exit("SHORT Exit", "SHORT", limit=strategy.position_avg_price - tp_points, stop=strategy.position_avg_price + sl_points)

// ---- Visuals
plot(orb_high, "ORB High", color=color.new(color.green, 20), style=plot.style_linebr, linewidth=2)
plot(orb_low,  "ORB Low",  color=color.new(color.red, 20),   style=plot.style_linebr, linewidth=2)
plot(ema_50,   "EMA 50",   color=color.yellow, linewidth=1)
plot(ema_200,  "EMA 200",  color=color.white,  linewidth=2)
plot(vwap_val, "VWAP",     color=color.orange, linewidth=1)

bgcolor(in_opening ? color.new(color.yellow, 85) : in_session ? color.new(color.blue, 95) : na)

plotshape(bull_engulfing and in_session, "Bull Engulf",  shape.labelup,   location.belowbar, color.new(color.green,  40), text="BE", textcolor=color.white, size=size.tiny)
plotshape(hammer          and in_session, "Hammer",      shape.labelup,   location.belowbar, color.new(color.lime,   40), text="H",  textcolor=color.white, size=size.tiny)
plotshape(bull_marubozu   and in_session, "Bull Maru",   shape.labelup,   location.belowbar, color.new(color.teal,   40), text="MB", textcolor=color.white, size=size.tiny)
plotshape(bear_engulfing  and in_session, "Bear Engulf", shape.labeldown, location.abovebar, color.new(color.red,    40), text="BE", textcolor=color.white, size=size.tiny)
plotshape(shooting_star   and in_session, "Shoot Star",  shape.labeldown, location.abovebar, color.new(color.maroon, 40), text="SS", textcolor=color.white, size=size.tiny)
plotshape(bear_marubozu   and in_session, "Bear Maru",   shape.labeldown, location.abovebar, color.new(color.purple, 40), text="MB", textcolor=color.white, size=size.tiny)

plotshape(long_ok  or orb_retest_long,  "BUY",  shape.triangleup,   location.belowbar, color.green, size=size.large)
plotshape(short_ok or orb_retest_short, "SELL", shape.triangledown,  location.abovebar, color.red,   size=size.large)

// ---- Dashboard
var table dash = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 60), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "ORB H/L",  text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 0, na(orb_high) ? "---" : str.tostring(math.round(orb_high, 0)) + "/" + str.tostring(math.round(orb_low, 0)), text_color=color.orange, text_size=size.small)
    table.cell(dash, 0, 1, "Trend",    text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 1, bull_trend ? "BULL" : bear_trend ? "BEAR" : "FLAT", text_color=bull_trend ? color.green : bear_trend ? color.red : color.gray, text_size=size.small)
    table.cell(dash, 0, 2, "ADX",      text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(math.round(adx_val, 1)), text_color=adx_val > adx_min ? color.green : color.red, text_size=size.small)
    table.cell(dash, 0, 3, "RSI",      text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(math.round(rsi_val, 1)), text_color=rsi_val > 72 ? color.red : rsi_val < 28 ? color.lime : color.white, text_size=size.small)
    table.cell(dash, 0, 4, "Bull Pat", text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 4, bull_candle ? "YES" : "NO", text_color=bull_candle ? color.green : color.gray, text_size=size.small)
    table.cell(dash, 0, 5, "Bear Pat", text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 5, bear_candle ? "YES" : "NO", text_color=bear_candle ? color.red : color.gray, text_size=size.small)
    table.cell(dash, 0, 6, "Trades",   text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(trades_today) + "/" + str.tostring(max_trades), text_color=trades_today >= max_trades ? color.red : color.green, text_size=size.small)
    table.cell(dash, 0, 7, "VWAP",     text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(math.round(vwap_val, 1)), text_color=color.orange, text_size=size.small)
