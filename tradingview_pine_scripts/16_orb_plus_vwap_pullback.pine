//@version=5
// Budget: 20,000 INR | 1 lot Nifty (75 units) | Commission: 100 INR per order
// Two entry types:
//   Type A - ORB Breakout: 9:30-11:00 AM only
//   Type B - VWAP Pullback: 11:00 AM-2:00 PM only
// Max 3 trades per day total | TP=40pts | SL=20pts | RR=2:1
strategy("16 - ORB + VWAP Pullback (1 Lot)", overlay=true,
         default_qty_type=strategy.fixed,
         default_qty_value=75,
         commission_type=strategy.commission.cash_per_order,
         commission_value=100)

// ---- Inputs
tp_points = input.float(40.0, "Take Profit (points)")
sl_points = input.float(20.0, "Stop Loss (points)")
adx_min   = input.int(18,    "Min ADX")

// ---- Indicators
ema_50   = ta.ema(close, 50)
ema_200  = ta.ema(close, 200)
atr_val  = ta.atr(14)
rsi_val  = ta.rsi(close, 14)
vwap_val = ta.vwap(hlc3)
[diplus, diminus, adx_val] = ta.dmi(14, 14)

// ---- Time windows
in_opening    = not na(time("5", "0915-0930", "Asia/Kolkata"))
in_orb_window = not na(time("5", "0930-1100", "Asia/Kolkata"))
in_pb_window  = not na(time("5", "1100-1400", "Asia/Kolkata"))

// ---- Daily reset
var float orb_high     = na
var float orb_low      = na
var bool  orb_done     = false
var int   trades_today = 0

if dayofweek != dayofweek[1]
    orb_high     := na
    orb_low      := na
    orb_done     := false
    trades_today := 0

// ---- Build opening range
if in_opening
    orb_high := na(orb_high) ? high : math.max(orb_high, high)
    orb_low  := na(orb_low)  ? low  : math.min(orb_low, low)
if not in_opening and not na(orb_high)
    orb_done := true

// ---- Shared filters
candle_size = high - low
body_size   = math.abs(close - open)
bull_body   = (close > open) and (body_size / candle_size > 0.55) and (candle_size > 18)
bear_body   = (close < open) and (body_size / candle_size > 0.55) and (candle_size > 18)
bull_trend  = close > ema_50 and close > ema_200
bear_trend  = close < ema_50 and close < ema_200
trending    = adx_val > adx_min
no_trade    = strategy.position_size != 0 or trades_today >= 3

// ---- TYPE A: ORB Breakout (9:30-11:00 AM)
orb_long  = orb_done and ta.crossover(close, orb_high) and bull_body and bull_trend and rsi_val > 50 and rsi_val < 70 and trending and in_orb_window and not no_trade
orb_short = orb_done and ta.crossunder(close, orb_low)  and bear_body and bear_trend and rsi_val < 50 and rsi_val > 30 and trending and in_orb_window and not no_trade

// ---- TYPE B: VWAP Pullback (11:00 AM-2:00 PM)
// Price pulled back near VWAP and bouncing with a strong candle
near_vwap_low  = low  < vwap_val + atr_val * 0.3 and low  > vwap_val - atr_val * 0.5
near_vwap_high = high > vwap_val - atr_val * 0.3 and high < vwap_val + atr_val * 0.5

pb_long  = bull_trend and near_vwap_low  and bull_body and close > vwap_val and rsi_val > 48 and rsi_val < 65 and trending and in_pb_window and not no_trade
pb_short = bear_trend and near_vwap_high and bear_body and close < vwap_val and rsi_val < 52 and rsi_val > 35 and trending and in_pb_window and not no_trade

// ---- Combined signal
long_ok  = orb_long  or pb_long
short_ok = orb_short or pb_short

// ---- Execute
if long_ok
    strategy.entry("LONG", strategy.long)
    trades_today := trades_today + 1

if short_ok
    strategy.entry("SHORT", strategy.short)
    trades_today := trades_today + 1

// ---- Fixed TP / SL
if strategy.position_size > 0
    strategy.exit("LONG Exit", "LONG",
         limit = strategy.position_avg_price + tp_points,
         stop  = strategy.position_avg_price - sl_points)

if strategy.position_size < 0
    strategy.exit("SHORT Exit", "SHORT",
         limit = strategy.position_avg_price - tp_points,
         stop  = strategy.position_avg_price + sl_points)

// ---- Visuals
plot(orb_high, "ORB High", color=color.new(color.green, 30), style=plot.style_linebr, linewidth=2)
plot(orb_low,  "ORB Low",  color=color.new(color.red, 30),   style=plot.style_linebr, linewidth=2)
plot(ema_50,   "EMA 50",   color=color.yellow,  linewidth=1)
plot(ema_200,  "EMA 200",  color=color.white,   linewidth=2)
plot(vwap_val, "VWAP",     color=color.orange,  linewidth=2)

bgcolor(in_opening    ? color.new(color.yellow, 85) : na, title="Opening Range")
bgcolor(in_orb_window ? color.new(color.blue,   95) : na, title="ORB Window")
bgcolor(in_pb_window  ? color.new(color.teal,   95) : na, title="Pullback Window")

plotshape(orb_long,  "ORB BUY",  shape.triangleup,   location.belowbar, color.lime,  size=size.large)
plotshape(orb_short, "ORB SELL", shape.triangledown,  location.abovebar, color.red,   size=size.large)
plotshape(pb_long,   "PB BUY",   shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(pb_short,  "PB SELL",  shape.triangledown,  location.abovebar, color.maroon,size=size.small)

// ---- Dashboard
var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 60), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Mode",     text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, in_orb_window ? "ORB" : in_pb_window ? "PULLBACK" : "CLOSED", text_color=in_orb_window ? color.blue : in_pb_window ? color.teal : color.gray, text_size=size.small)
    table.cell(dash, 0, 1, "ORB H/L",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, na(orb_high) ? "---" : str.tostring(math.round(orb_high,0)) + "/" + str.tostring(math.round(orb_low,0)), text_color=color.orange, text_size=size.small)
    table.cell(dash, 0, 2, "Trend",    text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, bull_trend ? "BULL" : bear_trend ? "BEAR" : "FLAT", text_color=bull_trend ? color.green : bear_trend ? color.red : color.gray, text_size=size.small)
    table.cell(dash, 0, 3, "ADX",      text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(math.round(adx_val,1)), text_color=adx_val > adx_min ? color.green : color.red, text_size=size.small)
    table.cell(dash, 0, 4, "RSI",      text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(math.round(rsi_val,1)), text_color=rsi_val > 70 ? color.red : rsi_val < 30 ? color.lime : color.white, text_size=size.small)
    table.cell(dash, 0, 5, "Trades",   text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(trades_today) + "/3", text_color=trades_today >= 3 ? color.red : color.green, text_size=size.small)
    table.cell(dash, 0, 6, "VWAP",     text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(math.round(vwap_val,1)), text_color=color.orange, text_size=size.small)
