//@version=5
strategy("12 - VWAP Pullback Strategy", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_order, commission_value=100)

// ---- Inputs
ema_len    = input.int(21,   "Trend EMA")
atr_len    = input.int(14,   "ATR Period")
sl_mult    = input.float(1.0, "Stop Loss (ATR x)")
tp_mult    = input.float(2.0, "Take Profit (ATR x) - 2:1 RR")
adx_min    = input.int(18,   "Min ADX (trend strength)")
touch_zone = input.float(0.3, "VWAP touch zone (ATR x) - how close price must be")

// ---- Indicators
ema_val  = ta.ema(close, ema_len)
atr_val  = ta.atr(atr_len)
vwap_val = ta.vwap(hlc3)
rsi_val  = ta.rsi(close, 14)
[diplus, diminus, adx_val] = ta.dmi(14, 14)

// ---- Session
in_session = not na(time("5", "0930-1445", "Asia/Kolkata"))

// ---- Step 1: Identify the trend direction
// Uptrend: price above EMA, EMA rising, close above VWAP
uptrend   = close > ema_val and ema_val > ema_val[3] and close > vwap_val
downtrend = close < ema_val and ema_val < ema_val[3] and close < vwap_val

// ---- Step 2: Detect pullback to VWAP
// Price came close to VWAP in last 1-3 bars (touched the zone)
near_vwap = math.abs(low - vwap_val) < atr_val * touch_zone or math.abs(low[1] - vwap_val) < atr_val * touch_zone
near_vwap_short = math.abs(high - vwap_val) < atr_val * touch_zone or math.abs(high[1] - vwap_val) < atr_val * touch_zone

// ---- Step 3: Bounce confirmation
// Bullish bounce: pulled back near VWAP, now closing higher with body above VWAP
bull_bounce = near_vwap and close > vwap_val and close > open and (close - open) > atr_val * 0.3

// Bearish bounce: pulled back near VWAP, now closing lower with body below VWAP
bear_bounce = near_vwap_short and close < vwap_val and close < open and (open - close) > atr_val * 0.3

// ---- Step 4: RSI confirmation (not overbought/oversold at entry)
rsi_ok_long  = rsi_val > 45 and rsi_val < 65
rsi_ok_short = rsi_val < 55 and rsi_val > 35

// ---- Step 5: ADX confirms we are in a trending market
trend_ok = adx_val > adx_min

// ---- Final signal
long_ok  = uptrend   and bull_bounce and rsi_ok_long  and trend_ok and in_session
short_ok = downtrend and bear_bounce and rsi_ok_short and trend_ok and in_session

// ---- Entry
if long_ok and strategy.position_size == 0
    strategy.entry("LONG", strategy.long)

if short_ok and strategy.position_size == 0
    strategy.entry("SHORT", strategy.short)

// ---- ATR Stop Loss + Take Profit
if strategy.position_size > 0
    sl = strategy.position_avg_price - atr_val * sl_mult
    tp = strategy.position_avg_price + atr_val * tp_mult
    strategy.exit("LONG Exit", "LONG", stop=sl, limit=tp)

if strategy.position_size < 0
    sl = strategy.position_avg_price + atr_val * sl_mult
    tp = strategy.position_avg_price - atr_val * tp_mult
    strategy.exit("SHORT Exit", "SHORT", stop=sl, limit=tp)

// ---- Visuals
plot(ema_val,  "EMA 21", color=color.yellow, linewidth=2)
plot(vwap_val, "VWAP",   color=color.orange, linewidth=2)
plot(vwap_val + atr_val * touch_zone, "VWAP Upper Zone", color=color.new(color.orange, 75), linewidth=1)
plot(vwap_val - atr_val * touch_zone, "VWAP Lower Zone", color=color.new(color.orange, 75), linewidth=1)

bgcolor(in_session ? color.new(color.blue, 95) : na, title="Market Hours")

plotshape(long_ok,  "BUY",  shape.triangleup,   location.belowbar, color.green, size=size.normal)
plotshape(short_ok, "SELL", shape.triangledown,  location.abovebar, color.red,   size=size.normal)

// ---- Dashboard
var table dash = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 65), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Trend",    text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 0, uptrend ? "UP" : downtrend ? "DOWN" : "FLAT", text_color=uptrend ? color.green : downtrend ? color.red : color.gray, text_size=size.small)
    table.cell(dash, 0, 1, "VWAP",     text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(math.round(vwap_val, 1)), text_color=color.orange, text_size=size.small)
    table.cell(dash, 0, 2, "EMA 21",   text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(math.round(ema_val, 1)),  text_color=color.yellow, text_size=size.small)
    table.cell(dash, 0, 3, "RSI",      text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(math.round(rsi_val, 1)),  text_color=rsi_val > 65 ? color.red : rsi_val < 35 ? color.lime : color.white, text_size=size.small)
    table.cell(dash, 0, 4, "ADX",      text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(math.round(adx_val, 1)),  text_color=adx_val > adx_min ? color.green : color.red, text_size=size.small)
    table.cell(dash, 0, 5, "ATR",      text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(math.round(atr_val, 1)),  text_color=color.white, text_size=size.small)
