//@version=5
strategy("AI Bot SuperTrend VWAP", overlay=true)

st_period = input.int(10, "SuperTrend Period")
st_mult = input.float(3.0, "SuperTrend Multiplier")
rsi_len = input.int(14, "RSI Period")
adx_min = input.int(20, "Min ADX")

[st, dir] = ta.supertrend(st_mult, st_period)
vwap_val = ta.vwap(hlc3)
rsi_val = ta.rsi(close, rsi_len)
[diplus, diminus, adx_val] = ta.dmi(14, 14)

long_ok = ta.crossunder(dir, 0) and close > vwap_val and adx_val > adx_min and rsi_val > 50
short_ok = ta.crossover(dir, 0) and close < vwap_val and adx_val > adx_min and rsi_val < 50

in_session = not na(time("5", "0930-1500", "Asia/Kolkata"))

// Strategy entries only during market hours
if long_ok and in_session
    strategy.entry("LONG", strategy.long)

if short_ok and in_session
    strategy.entry("SHORT", strategy.short)

if strategy.position_size > 0 and short_ok
    strategy.close("LONG")

if strategy.position_size < 0 and long_ok
    strategy.close("SHORT")

// Visuals — signals shown on chart at all times so you can verify logic
plot(st, "SuperTrend", color = dir < 0 ? color.green : color.red, linewidth=2)
plot(vwap_val, "VWAP", color=color.orange, linewidth=1)
bgcolor(in_session ? color.new(color.blue, 92) : na, title="Market Hours")

// Green triangle = BUY signal (any time), bright green = during session
plotshape(long_ok, "BUY", shape.triangleup, location.belowbar, in_session ? color.green : color.new(color.green, 60), size=size.small)
// Red triangle = SELL signal (any time), bright red = during session
plotshape(short_ok, "SELL", shape.triangledown, location.abovebar, in_session ? color.red : color.new(color.red, 60), size=size.small)
