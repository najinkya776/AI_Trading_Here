//@version=5
strategy("11 - Super Combined Strategy", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1)

// ---- Inputs
ema_fast_len  = input.int(9,    "Fast EMA (trigger)")
ema_slow_len  = input.int(21,   "Slow EMA (confirm)")
ema_trend_len = input.int(50,   "Trend EMA (direction)")
atr_len       = input.int(14,   "ATR Period")
sl_mult       = input.float(1.5, "Stop Loss ATR multiplier")
tp_mult       = input.float(3.0, "Take Profit ATR multiplier (2:1 RR)")
rsi_len       = input.int(14,   "RSI Period")
adx_min       = input.int(20,   "Min ADX for trend confirmation")

// ---- Indicators
ema_fast  = ta.ema(close, ema_fast_len)
ema_slow  = ta.ema(close, ema_slow_len)
ema_trend = ta.ema(close, ema_trend_len)
atr_val   = ta.atr(atr_len)
vwap_val  = ta.vwap(hlc3)
rsi_val   = ta.rsi(close, rsi_len)
[diplus, diminus, adx_val] = ta.dmi(14, 14)

// ---- Session: 9:30 AM to 3:00 PM IST
in_session = not na(time("5", "0930-1500", "Asia/Kolkata"))

// ---- Trend filters (all must align)
bull_trend = ema_fast > ema_slow and ema_slow > ema_trend and close > ema_trend
bear_trend = ema_fast < ema_slow and ema_slow < ema_trend and close < ema_trend

// ---- VWAP filter: price must be on correct side
bull_vwap = close > vwap_val
bear_vwap = close < vwap_val

// ---- RSI filter: not overbought on long entry, not oversold on short entry
bull_rsi = rsi_val > 45 and rsi_val < 68
bear_rsi = rsi_val < 55 and rsi_val > 32

// ---- Momentum: ADX confirms trending market
trending = adx_val > adx_min

// ---- Trigger: EMA crossover (fires 2-3 times per day)
long_trigger  = ta.crossover(ema_fast, ema_slow)
short_trigger = ta.crossunder(ema_fast, ema_slow)

// ---- Final signal: trigger + all filters must agree
long_ok  = long_trigger  and bull_trend and bull_vwap and bull_rsi and trending and in_session
short_ok = short_trigger and bear_trend and bear_vwap and bear_rsi and trending and in_session

// ---- Entry
if long_ok
    strategy.entry("LONG", strategy.long)

if short_ok
    strategy.entry("SHORT", strategy.short)

// ---- ATR-based Stop Loss and Take Profit (2:1 reward:risk)
if strategy.position_size > 0
    sl = strategy.position_avg_price - atr_val * sl_mult
    tp = strategy.position_avg_price + atr_val * tp_mult
    strategy.exit("LONG Exit", "LONG", stop=sl, limit=tp)

if strategy.position_size < 0
    sl = strategy.position_avg_price + atr_val * sl_mult
    tp = strategy.position_avg_price - atr_val * tp_mult
    strategy.exit("SHORT Exit", "SHORT", stop=sl, limit=tp)

// ---- Visuals
plot(ema_fast,  "EMA 9",  color=color.aqua,   linewidth=1)
plot(ema_slow,  "EMA 21", color=color.orange,  linewidth=1)
plot(ema_trend, "EMA 50", color=color.yellow,  linewidth=2)
plot(vwap_val,  "VWAP",   color=color.purple,  linewidth=1)

bgcolor(in_session ? color.new(color.blue, 95) : na, title="Market Hours")

plotshape(long_ok,  "BUY",  shape.triangleup,   location.belowbar, color.green, size=size.normal)
plotshape(short_ok, "SELL", shape.triangledown,  location.abovebar, color.red,   size=size.normal)

// ---- Info table (top right)
var table info = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "EMA Fast",  text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, str.tostring(math.round(ema_fast, 2)),  text_color=color.aqua,   text_size=size.small)
    table.cell(info, 0, 1, "EMA Slow",  text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(math.round(ema_slow, 2)),  text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 2, "VWAP",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(math.round(vwap_val, 2)), text_color=color.purple, text_size=size.small)
    table.cell(info, 0, 3, "RSI",       text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, str.tostring(math.round(rsi_val, 2)),  text_color=rsi_val > 68 ? color.red : rsi_val < 32 ? color.green : color.white, text_size=size.small)
    table.cell(info, 0, 4, "ADX",       text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, str.tostring(math.round(adx_val, 2)),  text_color=adx_val > adx_min ? color.green : color.red, text_size=size.small)
