//@version=5
// Budget: 20,000 INR | 1 lot Nifty (75 units) | Commission: 100 INR per order
// Target: 2 trades/day max | TP = 40 pts (3,000 INR) | SL = 20 pts (1,500 INR) | RR = 2:1
// Data insight: Opening range (9:15-9:30) averages 65 pts - largest opportunity of the day
strategy("15 - Data Driven ORB Final", overlay=true,
         default_qty_type=strategy.fixed,
         default_qty_value=75,
         commission_type=strategy.commission.cash_per_order,
         commission_value=100)

// ---- Fixed TP/SL in points (based on data analysis)
tp_points = input.float(40.0, "Take Profit (points)")
sl_points = input.float(20.0, "Stop Loss (points)")
adx_min   = input.int(18, "Min ADX for trend")

// ---- Indicators
ema_200  = ta.ema(close, 200)
ema_50   = ta.ema(close, 50)
atr_val  = ta.atr(14)
rsi_val  = ta.rsi(close, 14)
vwap_val = ta.vwap(hlc3)
[diplus, diminus, adx_val] = ta.dmi(14, 14)

// ---- Opening Range (9:15 - 9:30)
var float orb_high = na
var float orb_low  = na
var bool  orb_done = false
var int   trades_today = 0

in_opening = not na(time("5", "0915-0930", "Asia/Kolkata"))
in_session = not na(time("5", "0930-1400", "Asia/Kolkata"))

// Reset at start of new day
is_new_day = dayofweek != dayofweek[1]
if is_new_day
    orb_high    := na
    orb_low     := na
    orb_done    := false
    trades_today := 0

// Build opening range
if in_opening
    orb_high := na(orb_high) ? high : math.max(orb_high, high)
    orb_low  := na(orb_low)  ? low  : math.min(orb_low, low)

if not in_opening and not na(orb_high)
    orb_done := true

// ---- Confirmation filters
// 1. Strong breakout candle: body > 60% of range, candle size > 20 pts
candle_size   = high - low
body_size     = math.abs(close - open)
strong_bull   = (close > open) and (body_size / candle_size > 0.6) and (candle_size > 20)
strong_bear   = (close < open) and (body_size / candle_size > 0.6) and (candle_size > 20)

// 2. Trend alignment
bull_trend = close > ema_50 and close > ema_200 and close > vwap_val
bear_trend = close < ema_50 and close < ema_200 and close < vwap_val

// 3. RSI not extreme
rsi_ok_long  = rsi_val > 50 and rsi_val < 70
rsi_ok_short = rsi_val < 50 and rsi_val > 30

// 4. Market trending (ADX)
trending = adx_val > adx_min

// ---- Final signals: ORB breakout + strong candle + trend + RSI + max 2 trades/day
long_ok = orb_done
          and ta.crossover(close, orb_high)
          and strong_bull
          and bull_trend
          and rsi_ok_long
          and trending
          and in_session
          and trades_today < 2
          and strategy.position_size == 0

short_ok = orb_done
           and ta.crossunder(close, orb_low)
           and strong_bear
           and bear_trend
           and rsi_ok_short
           and trending
           and in_session
           and trades_today < 2
           and strategy.position_size == 0

// ---- Execute
if long_ok
    strategy.entry("LONG", strategy.long)
    trades_today := trades_today + 1

if short_ok
    strategy.entry("SHORT", strategy.short)
    trades_today := trades_today + 1

// ---- Fixed point TP and SL
if strategy.position_size > 0
    strategy.exit("LONG Exit", "LONG",
         limit = strategy.position_avg_price + tp_points,
         stop  = strategy.position_avg_price - sl_points)

if strategy.position_size < 0
    strategy.exit("SHORT Exit", "SHORT",
         limit = strategy.position_avg_price - tp_points,
         stop  = strategy.position_avg_price + sl_points)

// ---- Visuals
plot(orb_high, "ORB High", color=color.new(color.green, 30), style=plot.style_linebr, linewidth=2)
plot(orb_low,  "ORB Low",  color=color.new(color.red, 30),   style=plot.style_linebr, linewidth=2)
plot(ema_50,   "EMA 50",   color=color.yellow,  linewidth=1)
plot(ema_200,  "EMA 200",  color=color.white,   linewidth=2)
plot(vwap_val, "VWAP",     color=color.orange,  linewidth=1)

bgcolor(in_opening ? color.new(color.yellow, 85) : in_session ? color.new(color.blue, 95) : na)
plotshape(long_ok,  "BUY",  shape.triangleup,   location.belowbar, color.green, size=size.large)
plotshape(short_ok, "SELL", shape.triangledown,  location.abovebar, color.red,   size=size.large)

// ---- Dashboard
var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 60), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "ORB High", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, na(orb_high) ? "---" : str.tostring(math.round(orb_high, 1)), text_color=color.green, text_size=size.small)
    table.cell(dash, 0, 1, "ORB Low",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, na(orb_low)  ? "---" : str.tostring(math.round(orb_low, 1)),  text_color=color.red, text_size=size.small)
    table.cell(dash, 0, 2, "Trend",    text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, bull_trend ? "BULL" : bear_trend ? "BEAR" : "FLAT", text_color=bull_trend ? color.green : bear_trend ? color.red : color.gray, text_size=size.small)
    table.cell(dash, 0, 3, "ADX",      text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(math.round(adx_val, 1)), text_color=adx_val > adx_min ? color.green : color.red, text_size=size.small)
    table.cell(dash, 0, 4, "RSI",      text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(math.round(rsi_val, 1)), text_color=rsi_val > 70 ? color.red : rsi_val < 30 ? color.lime : color.white, text_size=size.small)
    table.cell(dash, 0, 5, "Trades",   text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(trades_today) + "/2", text_color=trades_today >= 2 ? color.red : color.green, text_size=size.small)
    table.cell(dash, 0, 6, "Budget",   text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, "20K | 1 Lot", text_color=color.aqua, text_size=size.small)
