//@version=5
strategy("10 - ATR Trend Following + EMA", overlay=true)

ema_len = input.int(50, "EMA Period")
atr_len = input.int(14, "ATR Period")
atr_mult = input.float(1.5, "ATR Multiplier")

ema_val = ta.ema(close, ema_len)
atr_val = ta.atr(atr_len)
vwap_val = ta.vwap(hlc3)

in_session = not na(time("5", "0930-1500", "Asia/Kolkata"))

long_ok = ta.crossover(close, ema_val + atr_val * atr_mult) and close > vwap_val and in_session
short_ok = ta.crossunder(close, ema_val - atr_val * atr_mult) and close < vwap_val and in_session

if long_ok
    strategy.entry("LONG", strategy.long)
if short_ok
    strategy.entry("SHORT", strategy.short)

if strategy.position_size > 0 and short_ok
    strategy.close("LONG")
if strategy.position_size < 0 and long_ok
    strategy.close("SHORT")

plot(ema_val, "EMA", color=color.yellow, linewidth=2)
plot(ema_val + atr_val * atr_mult, "Upper Entry Zone", color=color.green, linewidth=1)
plot(ema_val - atr_val * atr_mult, "Lower Entry Zone", color=color.red, linewidth=1)
plot(vwap_val, "VWAP", color=color.orange, linewidth=1)
bgcolor(in_session ? color.new(color.blue, 95) : na)
plotshape(long_ok, "BUY", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(short_ok, "SELL", shape.triangledown, location.abovebar, color.red, size=size.small)
